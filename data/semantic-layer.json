{
  "entities": {
    "EconomicCapital": {
      "title": "Экономический капитал",
      "description": "Ключевая метрика риска и капитала по методологии банка.",
      "attributes": ["value", "as_of_date", "calculation_snapshot", "scenario", "portfolio", "methodology_version"],
      "attribute_meta": {
        "as_of_date": {
          "required": true,
          "label": "Дата",
          "clarify_order": 1,
          "question": "За какую дату вам нужен ЭК?"
        },
        "calculation_snapshot": {
          "required": true,
          "label": "Срез расчёта",
          "clarify_order": 2,
          "question": "Какой срез расчёта использовать?",
          "allowed_values": [
            { "id": "latest", "labels": ["последний", "последний срез", "latest"] },
            { "id": "preliminary", "labels": ["предварительный", "preliminary"] },
            { "id": "official", "labels": ["официальный", "official"] }
          ]
        },
        "scenario": {
          "required": true,
          "label": "Сценарий",
          "clarify_order": 3,
          "question": "Какой сценарий использовать?",
          "allowed_values": [
            { "id": "base", "labels": ["базовый", "базовый сценарий", "base"] },
            { "id": "stress", "labels": ["стрессовый", "стресс", "stress"] },
            { "id": "alternative", "labels": ["альтернативный", "alternative"] }
          ]
        },
        "period_range": {
          "required": false,
          "label": "Период",
          "clarify_order": 1,
          "question": "За какой период нужен анализ?"
        }
      },
      "operations": ["get_value", "compare", "aggregate", "analyze_dynamics", "explain_change"]
    },
    "EconomicCapitalComponent": {
      "title": "Компонент экономического капитала",
      "description": "Составная часть экономического капитала по типу риска или сегменту.",
      "attributes": ["component_value", "risk_type"],
      "operations": ["get_value", "decompose"]
    },
    "EconomicCapitalChange": {
      "title": "Изменение экономического капитала",
      "description": "Абсолютное и относительное изменение метрики между периодами.",
      "attributes": ["absolute_change", "relative_change"],
      "operations": ["explain_change", "analyze_dynamics"]
    },
    "Portfolio": {
      "title": "Портфель",
      "description": "Срез расчёта: корпоративный, розничный и другие портфели банка.",
      "attributes": ["portfolio_id", "portfolio_name", "portfolio_type"],
      "operations": ["filter", "compare_portfolios"]
    },
    "RiskFactor": {
      "title": "Фактор риска",
      "description": "Драйвер изменения экономического капитала (объём, параметры риска, структура).",
      "operations": ["find_drivers", "decompose"]
    },
    "FactorContribution": {
      "title": "Вклад фактора",
      "description": "Количественный вклад фактора в изменение экономического капитала.",
      "operations": ["analyze_contribution", "decompose"]
    },
    "Methodology": {
      "title": "Методология",
      "description": "Версия методики расчёта, влияющая на сопоставимость результатов.",
      "attributes": ["methodology_version"]
    },
    "Scenario": {
      "title": "Сценарий",
      "description": "Базовый или стрессовый сценарий для расчёта метрики.",
      "attributes": ["scenario"]
    },
    "Client": {
      "title": "Клиент",
      "description": "Контрагент в составе портфеля, связанный с риском и капиталом.",
      "attributes": ["client_id", "segment"],
      "operations": ["filter"]
    },
    "Product": {
      "title": "Продукт",
      "description": "Банковский продукт, в рамках которого формируется экспозиция.",
      "attributes": ["product_id", "product_type"],
      "operations": ["filter"]
    },
    "RiskType": {
      "title": "Тип риска",
      "description": "Классификация риска для компонентов экономического капитала.",
      "attributes": ["risk_type"],
      "operations": ["filter", "aggregate"]
    },
    "ReportingPeriod": {
      "title": "Отчётный период",
      "attributes": ["from", "to"]
    }
  },
  "relationships": [
    { "from": "EconomicCapital", "to": "EconomicCapitalComponent", "type": "consists_of" },
    { "from": "EconomicCapital", "to": "Portfolio", "type": "calculated_for" },
    { "from": "EconomicCapital", "to": "RiskFactor", "type": "affected_by" },
    { "from": "EconomicCapital", "to": "EconomicCapitalChange", "type": "has_change" },
    { "from": "EconomicCapitalChange", "to": "FactorContribution", "type": "decomposed_by" },
    { "from": "FactorContribution", "to": "RiskFactor", "type": "attributed_to" }
  ],
  "business_rules": [
    "Сравнение выполняется только для сопоставимых периодов",
    "Для сравнения портфелей используется одна версия методологии",
    "Декомпозиция изменения доступна только при наличии факторного витринного слоя"
  ],
  "operation_inputs": {
    "get_value": ["as_of_date", "calculation_snapshot", "scenario"],
    "aggregate": ["as_of_date", "calculation_snapshot", "scenario"],
    "filter": ["as_of_date", "calculation_snapshot", "scenario"],
    "compare": ["period_1", "period_2", "calculation_snapshot", "scenario"],
    "analyze_dynamics": ["period_range", "calculation_snapshot", "scenario"],
    "explain_change": ["period_1", "period_2", "calculation_snapshot", "scenario"],
    "compare_portfolios": ["portfolio_1", "portfolio_2", "as_of_date", "calculation_snapshot", "scenario"],
    "find_drivers": ["period_1", "period_2", "calculation_snapshot", "scenario"],
    "decompose": ["period_1", "period_2", "calculation_snapshot", "scenario"]
  },
  "dimension_phrases": [
    { "patterns": ["по продукт", "по продуктам", "структур.*продукт"], "dimension": "product", "entity": "Product" },
    { "patterns": ["по сегмент", "по сегментам"], "dimension": "client_segment", "entity": "ClientSegment" },
    { "patterns": ["по гбл", "по gbl"], "dimension": "gbl", "entity": "ClientSegment" },
    { "patterns": ["по портфел", "по портфелям"], "dimension": "portfolio", "entity": "Portfolio" },
    { "patterns": ["по типам риска", "по типу риска"], "dimension": "risk_type", "entity": "RiskType" }
  ],
  "clarify_sequence": ["as_of_date", "calculation_snapshot", "scenario"],
  "operations": [
    "get_value",
    "compare",
    "aggregate",
    "filter",
    "analyze_dynamics",
    "explain_change",
    "find_drivers",
    "decompose",
    "compare_portfolios",
    "analyze_contribution",
    "check_comparability",
    "detect_anomaly"
  ],
  "intents": [
    {
      "id": "aggregate",
      "patterns": ["по продукт", "по сегмент", "по гбл", "по портфел", "структур", "в разрезе"],
      "operation": "aggregate"
    },
    {
      "id": "get_value",
      "patterns": ["покажи", "показать", "какой", "сколько", "значение", "get value"],
      "operation": "get_value"
    },
    {
      "id": "analyze_dynamics",
      "patterns": ["изменился", "изменилась", "динамик", "за июнь", "за май", "тренд"],
      "operation": "analyze_dynamics"
    },
    {
      "id": "explain_change",
      "patterns": ["почему", "причина", "объясни", "вырос", "выросла", "упал", "снизился"],
      "operation": "explain_change"
    },
    {
      "id": "compare_portfolios",
      "patterns": ["сравни", "сравнить", "сравнение", "корпоративн", "розничн"],
      "operation": "compare_portfolios"
    }
  ]
}
